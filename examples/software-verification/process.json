{
  "schema_version": "0.2",
  "name": "software.verification",
  "description": "Synthetic software verification with exact routing, optional caller review and an immutable report",
  "input_schema": {
    "type": "object",
    "required": [
      "change_id",
      "checks_passed"
    ],
    "properties": {
      "change_id": {
        "type": "string"
      },
      "checks_passed": {
        "type": "boolean"
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "result",
      "report"
    ],
    "properties": {
      "result": {
        "type": "object"
      },
      "report": {
        "type": "object"
      }
    },
    "additionalProperties": false
  },
  "config": {
    "schema": {
      "type": "object",
      "additionalProperties": false
    },
    "defaults": {},
    "run_override_keys": []
  },
  "capabilities": [
    {
      "kind": "builtin"
    },
    {
      "kind": "artifacts"
    },
    {
      "kind": "agent",
      "capability": "review"
    }
  ],
  "limits": {
    "max_step_ms": 10000,
    "max_artifact_bytes": 65536,
    "max_provider_calls": 0,
    "max_agent_requests": 1
  },
  "steps": [
    {
      "id": "route",
      "kind": "decision",
      "effect": "pure",
      "needs": [],
      "inputs": {},
      "retry": {
        "max_attempts": 1
      },
      "decision": {
        "source": "rules",
        "routes": [
          "ready",
          "investigate"
        ],
        "cases": [
          {
            "value": {
              "input": "/checks_passed"
            },
            "equals": true,
            "route": "ready"
          }
        ],
        "default": "investigate"
      }
    },
    {
      "id": "ready",
      "kind": "builtin",
      "effect": "pure",
      "needs": [
        "route"
      ],
      "retry": {
        "max_attempts": 1
      },
      "when": {
        "decision": "route",
        "route": "ready"
      },
      "operation": "json.select",
      "inputs": {
        "value": {
          "literal": {
            "status": "ready_for_owner_review",
            "reason": "Supplied checks passed"
          }
        },
        "pointer": {
          "literal": ""
        }
      }
    },
    {
      "id": "investigate",
      "kind": "agent",
      "effect": "agent",
      "needs": [
        "route"
      ],
      "retry": {
        "max_attempts": 1
      },
      "when": {
        "decision": "route",
        "route": "investigate"
      },
      "capability": "review",
      "instructions": "Review the supplied synthetic check summary. Return status and reason. Do not run commands or claim independent verification.",
      "inputs": {
        "record": {
          "input": ""
        }
      },
      "result_schema": {
        "type": "object",
        "required": [
          "status",
          "reason"
        ],
        "properties": {
          "status": {
            "type": "string",
            "maxLength": 200
          },
          "reason": {
            "type": "string",
            "maxLength": 200
          }
        },
        "additionalProperties": false
      }
    },
    {
      "id": "join",
      "kind": "join",
      "effect": "pure",
      "needs": [
        "route",
        "ready",
        "investigate"
      ],
      "inputs": {},
      "retry": {
        "max_attempts": 1
      },
      "join": {
        "decision": "route",
        "branches": {
          "ready": {
            "step": "ready",
            "pointer": "/value"
          },
          "investigate": {
            "step": "investigate",
            "pointer": ""
          }
        }
      }
    },
    {
      "id": "report",
      "kind": "builtin",
      "operation": "json.write",
      "effect": "pure",
      "needs": [
        "join"
      ],
      "retry": {
        "max_attempts": 2
      },
      "inputs": {
        "value": {
          "step": "join",
          "pointer": ""
        }
      }
    }
  ],
  "output": {
    "result": {
      "step": "join",
      "pointer": ""
    },
    "report": {
      "step": "report",
      "pointer": "/artifact"
    }
  }
}
