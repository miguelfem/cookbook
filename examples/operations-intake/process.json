{
  "schema_version": "0.2",
  "name": "operations.intake",
  "description": "Synthetic operations intake with exact routing, optional caller review and an immutable report",
  "input_schema": {
    "type": "object",
    "required": [
      "severity",
      "summary"
    ],
    "properties": {
      "severity": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "result",
      "report"
    ],
    "properties": {
      "result": {
        "type": "object"
      },
      "report": {
        "type": "object"
      }
    },
    "additionalProperties": false
  },
  "config": {
    "schema": {
      "type": "object",
      "additionalProperties": false
    },
    "defaults": {},
    "run_override_keys": []
  },
  "capabilities": [
    {
      "kind": "builtin"
    },
    {
      "kind": "artifacts"
    },
    {
      "kind": "agent",
      "capability": "review"
    }
  ],
  "limits": {
    "max_step_ms": 10000,
    "max_artifact_bytes": 65536,
    "max_provider_calls": 0,
    "max_agent_requests": 1
  },
  "steps": [
    {
      "id": "route",
      "kind": "decision",
      "effect": "pure",
      "needs": [],
      "inputs": {},
      "retry": {
        "max_attempts": 1
      },
      "decision": {
        "source": "rules",
        "routes": [
          "escalate",
          "routine"
        ],
        "cases": [
          {
            "value": {
              "input": "/severity"
            },
            "equals": "critical",
            "route": "escalate"
          }
        ],
        "default": "routine"
      }
    },
    {
      "id": "escalate",
      "kind": "agent",
      "effect": "agent",
      "needs": [
        "route"
      ],
      "retry": {
        "max_attempts": 1
      },
      "when": {
        "decision": "route",
        "route": "escalate"
      },
      "capability": "review",
      "instructions": "Review this synthetic operations intake. Return a queue and action only; no real notification is authorized.",
      "inputs": {
        "record": {
          "input": ""
        }
      },
      "result_schema": {
        "type": "object",
        "required": [
          "queue",
          "action"
        ],
        "properties": {
          "queue": {
            "type": "string",
            "maxLength": 200
          },
          "action": {
            "type": "string",
            "maxLength": 200
          }
        },
        "additionalProperties": false
      }
    },
    {
      "id": "routine",
      "kind": "builtin",
      "effect": "pure",
      "needs": [
        "route"
      ],
      "retry": {
        "max_attempts": 1
      },
      "when": {
        "decision": "route",
        "route": "routine"
      },
      "operation": "json.select",
      "inputs": {
        "value": {
          "literal": {
            "queue": "standard",
            "action": "scheduled_review"
          }
        },
        "pointer": {
          "literal": ""
        }
      }
    },
    {
      "id": "join",
      "kind": "join",
      "effect": "pure",
      "needs": [
        "route",
        "escalate",
        "routine"
      ],
      "inputs": {},
      "retry": {
        "max_attempts": 1
      },
      "join": {
        "decision": "route",
        "branches": {
          "escalate": {
            "step": "escalate",
            "pointer": ""
          },
          "routine": {
            "step": "routine",
            "pointer": "/value"
          }
        }
      }
    },
    {
      "id": "report",
      "kind": "builtin",
      "operation": "json.write",
      "effect": "pure",
      "needs": [
        "join"
      ],
      "retry": {
        "max_attempts": 2
      },
      "inputs": {
        "value": {
          "step": "join",
          "pointer": ""
        }
      }
    }
  ],
  "output": {
    "result": {
      "step": "join",
      "pointer": ""
    },
    "report": {
      "step": "report",
      "pointer": "/artifact"
    }
  }
}
