{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:apr:process:0.1",
  "title": "APR draft process manifest",
  "description": "Proposed contract. JSON Schema shape validation is separate from semantic admission and authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "description",
    "input_schema",
    "output_schema",
    "config",
    "capabilities",
    "limits",
    "steps",
    "output"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,79}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "defaults",
        "run_override_keys"
      ],
      "properties": {
        "schema": {
          "type": "object"
        },
        "defaults": {
          "type": "object"
        },
        "run_override_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "artifacts",
              "builtin",
              "script",
              "connection",
              "agent"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_step_ms",
        "max_artifact_bytes",
        "max_provider_calls",
        "max_agent_requests"
      ],
      "properties": {
        "max_step_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "max_artifact_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_provider_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "max_agent_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/binding"
      }
    }
  },
  "$defs": {
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "literal"
          ],
          "properties": {
            "literal": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input"
          ],
          "properties": {
            "input": {
              "type": "string",
              "pattern": "^(|/.*)$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step",
            "pointer"
          ],
          "properties": {
            "step": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "pointer": {
              "type": "string",
              "pattern": "^(|/.*)$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item"
          ],
          "properties": {
            "item": {
              "type": "string",
              "pattern": "^(|/.*)$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "config"
          ],
          "properties": {
            "config": {
              "type": "string"
            }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256",
        "media_type",
        "bytes"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "needs",
        "effect",
        "retry",
        "inputs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "kind": {
          "enum": [
            "builtin",
            "script",
            "connector",
            "agent",
            "approval"
          ]
        },
        "needs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "effect": {
          "enum": [
            "pure",
            "read",
            "write",
            "agent"
          ]
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_attempts"
          ],
          "properties": {
            "max_attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/binding"
          }
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "connection": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "instructions": {
          "type": "string",
          "maxLength": 4000
        },
        "result_schema": {
          "type": "object"
        },
        "foreach": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "items",
            "key",
            "max_items",
            "concurrency"
          ],
          "properties": {
            "items": {
              "$ref": "#/$defs/binding"
            },
            "key": {
              "type": "string",
              "pattern": "^/.*"
            },
            "max_items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "concurrency": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "builtin"
              }
            }
          },
          "then": {
            "required": [
              "operation"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "script"
              }
            }
          },
          "then": {
            "required": [
              "entrypoint"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "connector"
              }
            }
          },
          "then": {
            "required": [
              "connection",
              "operation"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "agent"
              }
            }
          },
          "then": {
            "required": [
              "capability",
              "instructions",
              "result_schema"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "approval"
              }
            }
          },
          "then": {
            "required": [
              "instructions"
            ]
          }
        }
      ]
    }
  }
}
