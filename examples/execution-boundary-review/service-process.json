{
  "schema_version": "0.2",
  "name": "synthetic.service-brief",
  "description": "Two scoped service reads return a compact decision brief without caller handoffs.",
  "input_schema": {
    "type": "object",
    "required": [
      "record_id"
    ],
    "properties": {
      "record_id": {
        "type": "string",
        "maxLength": 64
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "record",
      "policy"
    ],
    "properties": {
      "record": {
        "type": "object"
      },
      "policy": {
        "type": "object"
      }
    },
    "additionalProperties": false
  },
  "config": {
    "schema": {
      "type": "object",
      "additionalProperties": false
    },
    "defaults": {},
    "run_override_keys": []
  },
  "capabilities": [
    {
      "kind": "connection",
      "name": "records"
    },
    {
      "kind": "connection",
      "name": "policy"
    }
  ],
  "limits": {
    "max_step_ms": 10000,
    "max_artifact_bytes": 1048576,
    "max_provider_calls": 2,
    "max_agent_requests": 0
  },
  "steps": [
    {
      "id": "fetch_record",
      "kind": "connector",
      "operation": "mcp.call",
      "connection": "records",
      "needs": [],
      "effect": "read",
      "retry": {
        "max_attempts": 1
      },
      "inputs": {
        "record_id": {
          "input": "/record_id"
        }
      },
      "result_schema": {
        "type": "object",
        "required": [
          "summary",
          "revision"
        ],
        "properties": {
          "summary": {
            "type": "object"
          },
          "revision": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    {
      "id": "fetch_policy",
      "kind": "connector",
      "operation": "mcp.call",
      "connection": "policy",
      "needs": [
        "fetch_record"
      ],
      "effect": "read",
      "retry": {
        "max_attempts": 1
      },
      "inputs": {
        "revision": {
          "step": "fetch_record",
          "pointer": "/revision"
        }
      },
      "result_schema": {
        "type": "object",
        "required": [
          "decision_rules",
          "revision"
        ],
        "properties": {
          "decision_rules": {
            "type": "object"
          },
          "revision": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  ],
  "output": {
    "record": {
      "step": "fetch_record",
      "pointer": "/summary"
    },
    "policy": {
      "step": "fetch_policy",
      "pointer": "/decision_rules"
    }
  }
}
