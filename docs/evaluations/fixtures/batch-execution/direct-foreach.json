{
  "schema_version": "0.2",
  "name": "batch.direct-foreach",
  "description": "Synthetic, provider-free batch execution proof.",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "jobs": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "payload": {
              "type": "object"
            },
            "pointer": {
              "type": "string",
              "maxLength": 80
            }
          },
          "required": [
            "id",
            "payload",
            "pointer"
          ]
        }
      }
    },
    "required": [
      "jobs"
    ]
  },
  "output_schema": {
    "type": "object"
  },
  "config": {
    "schema": {
      "type": "object",
      "additionalProperties": false
    },
    "defaults": {},
    "run_override_keys": []
  },
  "capabilities": [
    {
      "kind": "builtin"
    }
  ],
  "limits": {
    "max_step_ms": 1000,
    "max_artifact_bytes": 1048576,
    "max_provider_calls": 0,
    "max_agent_requests": 0,
    "max_call_depth": 4,
    "max_child_runs": 16,
    "max_step_instances": 64
  },
  "steps": [
    {
      "id": "jobs",
      "kind": "builtin",
      "operation": "json.select",
      "effect": "pure",
      "needs": [],
      "retry": {
        "max_attempts": 1
      },
      "foreach": {
        "items": {
          "input": "/jobs"
        },
        "key": "/id",
        "max_items": 8,
        "concurrency": 4
      },
      "inputs": {
        "value": {
          "item": "/payload"
        },
        "pointer": {
          "item": "/pointer"
        }
      }
    }
  ],
  "output": {
    "results": {
      "step": "jobs",
      "pointer": "/items"
    }
  }
}
